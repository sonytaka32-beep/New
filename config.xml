<?xml version='1.0' encoding='utf-8'?>
<widget id="com.sonytaka32.shisuicalc" version="6.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Shisui Calc</name>
  <description>Offline calculator with scientific functions and a locally bundled Shisui-inspired Susanoo visual theme.</description>
  <author email="sonytaka32-beep@users.noreply.github.com" href="https://github.com/sonytaka32-beep">Community modification</author>
  <content src="index.html" />
  <access origin="https://*" />
  <access origin="http://localhost" />
  <allow-navigation href="https://*" />
  <allow-navigation href="http://localhost/*" />
  <allow-intent href="https://*" />
  <allow-intent href="mailto:*" />
  <platform name="android">
    <icon src="res/icon/android/icon-36-ldpi.png" density="ldpi" />
    <icon src="res/icon/android/icon-48-mdpi.png" density="mdpi" />
    <icon src="res/icon/android/icon-72-hdpi.png" density="hdpi" />
    <icon src="res/icon/android/icon-96-xhdpi.png" density="xhdpi" />
    <icon src="res/icon/android/icon-144-xxhdpi.png" density="xxhdpi" />
    <icon src="res/icon/android/icon-192-xxxhdpi.png" density="xxxhdpi" />
    <preference name="AndroidLaunchMode" value="singleTop" />
    <preference name="Fullscreen" value="false" />
    <preference name="AndroidWindowSplashScreenBackground" value="#08090b" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
  </platform>
</widget>