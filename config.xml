<?xml version='1.0' encoding='utf-8'?>
<widget id="com.sonytaka32.shisuicalc" version="4.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Shisui Calc</name>
  <description>Offline calculator with scientific functions and a locally bundled Shisui-inspired Susanoo visual theme.</description>
  <author email="sonytaka32-beep@users.noreply.github.com" href="https://github.com/sonytaka32-beep">Community modification</author>
  <content src="index.html" />
  <access origin="https://*" />
  <access origin="http://localhost" />
  <allow-navigation href="https://*" />
  <allow-navigation href="http://localhost/*" />
  <allow-intent href="https://*" />
  <allow-intent href="mailto:*" />
  <platform name="android">
    <preference name="AndroidLaunchMode" value="singleTop" />
    <preference name="Fullscreen" value="false" />
    <preference name="AndroidWindowSplashScreenBackground" value="#08090b" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
  </platform>
</widget>
